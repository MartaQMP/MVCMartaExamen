@model List<Evento>

<div class="container py-5">
    <div class="text-center mb-5 bg-dark text-white rounded-3 p-5 shadow-sm">
        <h1 class="display-4 fw-bold">🎵 Vive la Música en Directo 🎵</h1>
        <p class="lead text-muted-light">Explora todos los eventos disponibles y asegura tu sitio en primera fila.</p>
        <a asp-action="Buscador" class="btn btn-warning btn-lg fw-bold mt-2">
            Ir al Buscador por Categorías
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-card">
                        <div class="position-relative">
                            <img src="@ViewBag.UrlBucket@ev.Imagen" class="card-img-top" alt="@ev.Nombre" style="height: 240px; object-fit: cover;" ">
                            <span class="position-absolute bottom-0 start-0 bg-dark text-warning px-3 py-1 m-2 rounded-pill small fw-bold">
                                Concierto
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-2">@ev.Nombre</h5>
                            <p class="card-text text-secondary mb-4">
                                <i class="bi bi-mic-fill text-danger me-2"></i><strong>Artista:</strong> @ev.Artista
                            </p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info border-0 shadow-sm p-4">
                    <h3>No hay eventos programados en este momento</h3>
                    <p class="mb-0">Vuelve a conectarte más tarde para ver las novedades.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
    .text-muted-light {
        color: #ced4da;
    }
</style>