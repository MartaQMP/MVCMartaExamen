@{
    ViewData["Title"] = "Convertir a Mayúsculas";
}

<h2>Convertir texto a mayúsculas</h2>

<form method="post">
    <div class="mb-3">
        <input type="text" name="texto" class="form-control" placeholder="Escribe algo..." />
    </div>
    <button type="submit" class="btn btn-primary">Convertir</button>
</form>

@if (ViewData["resultado"] != null)
{
    <div class="mt-3 alert alert-success">
        <strong>Resultado:</strong> @ViewData["resultado"]
    </div>
}
